# svault-bot — шаблон секретов и окружения
# Каноническое место: bot/.env (тот же формат). Секреты — только там.
# Скопируй этот файл в bot/.env и замени CHANGE_ME на реальные значения.
# Этот файл (.env.example) коммитится, сами секреты — НИКОГДА.

# --- обязательные секреты (плейсхолдеры) ---
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
GITHUB_TOKEN=CHANGE_ME_GITHUB_TOKEN_PAT_contents_write_issues_write
TELEGRAM_CHAT_IDS=CHANGE_ME_CHAT_ID_1,CHANGE_ME_CHAT_ID_2

# --- не-секреты, но нужны боту ---
OWNER_ID=5722152704
BOT_USERNAME=selenevaultbot
SITE_URL=https://svault.jzadl.xyz
REPO_ROOT=/home/main/projects/selenevault
DATABASE_URL=postgres://svault:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/svault
PORT=8087
# Webhook shared secret (любая случайная строка, та же в setWebhook?secret_token=...)
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_RANDOM_32_CHARS
# Необязательно: если пусто — бот создаст telegraph-аккаунт сам
TELEGRAPH_ACCESS_TOKEN=
