name: Deploy svault-bot

on:
  push:
    branches: [main]
    paths:
      - "bot/**"
  workflow_dispatch: {}

jobs:
  deploy:
    runs-on: ubuntu-latest
    permissions:
      issues: write
    defaults:
      run:
        working-directory: bot
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Install wrangler
        run: npm install -g wrangler

      - name: Deploy to Cloudflare Workers
        id: deploy
        continue-on-error: true
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        run: |
          printf '%s' "${{ secrets.TELEGRAM_BOT_TOKEN }}" | wrangler secret put TELEGRAM_BOT_TOKEN --name svault-bot 2>&1
          printf '%s' "${{ secrets.GROQ_API_KEY }}" | wrangler secret put GROQ_API_KEY --name svault-bot 2>&1
          printf '%s' "${{ secrets.PUSH_TOKEN }}" | wrangler secret put GITHUB_TOKEN --name svault-bot 2>&1
          wrangler deploy 2>&1
